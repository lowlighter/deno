{
  "tempDir": true,
  "tests": {
    "drop_labels": {
      "steps": [
        {
          "args": "bundle --output=out.js --drop-labels=DEV,TEST main.ts",
          "output": "[WILDCARD]"
        },
        {
          "args": "run --no-lock --cached-only --no-config -A out.js",
          "output": "always runs\n"
        }
      ]
    },
    "drop_single_label": {
      "steps": [
        {
          "args": "bundle --output=out.js --drop-labels=DEV main.ts",
          "output": "[WILDCARD]"
        },
        {
          "args": "run --no-lock --cached-only --no-config -A out.js",
          "output": "test-only logging\nalways runs\n"
        }
      ]
    }
  }
}
